# Copy to .env.local and fill in. Compose supplies its own values for the
# containerised services; these are for running tooling on the host.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_tracker

# LocalStack in Phase 1. Unset entirely in Phase 2 so the SDK resolves real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=job-tracker-docs

# Required for job-description parsing (Step 6).
ANTHROPIC_API_KEY=sk-ant-...
